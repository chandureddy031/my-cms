# Postgres connection (Render: the database's Internal Database URL)
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Editor key for /apple — required in production, 12+ random characters
ADMIN_KEY=change-me-to-a-long-random-key
# Live website URL(s) allowed to call the API from the browser, comma-separated
FRONTEND_URL=https://chandutechstack.me,https://www.chandutechstack.me,https://apples-web.onrender.com
