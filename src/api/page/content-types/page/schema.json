{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": { "singularName": "page", "pluralName": "pages", "displayName": "Page" },
  "options": { "draftAndPublish": true },
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "navOrder": { "type": "integer", "default": 0 },
    "showInNav": { "type": "boolean", "default": true },
    "metaDescription": { "type": "text" },
    "sections": {
      "type": "dynamiczone",
      "components": ["sections.hero", "sections.text-block", "sections.cards", "sections.stats", "sections.cta", "sections.donation-form", "sections.contact-info"]
    }
  }
}
